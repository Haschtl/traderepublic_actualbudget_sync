# Mode: set to "mock" for local development without real credentials
APP_MODE=mock
# Cron 5 champs pour le sync automatique. Vide = désactivé. Défaut: tous les jours à 00:00.
SYNC_CRON=0 1 * * *
# Optional: protège l'UI et l'API par Basic Auth si les deux valeurs sont remplies
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=

# Trade Republic (pytr) — lorsqu'en mode non-mock fournir les credentials nécessaires
TR_PHONE_NUMBER=
TR_PIN=

# Actual Budget — serveur ou instance (pour utiliser actualpy ou HTTP API)
ACTUAL_URL=http://localhost:5006
ACTUAL_PASSWORD=
# Mot de passe de chiffrement du fichier budget Actual (si le budget est chiffré)
ACTUAL_ENCRYPTION_PASSWORD=
ACTUAL_BUDGET_ID=
# Comptes Actual auto-créés pour Trade Republic
ACTUAL_CASH_ACCOUNT_NAME=Trade Republic Cash
ACTUAL_DEPOT_ACCOUNT_NAME=Trade Republic Depot
# Optional: compte externe pour BANK_TRANSACTION_INCOMING/OUTGOING
ACTUAL_TRANSFER_ACCOUNT_NAME=
# Optional: si true, crée une contre-écriture externe si aucune transaction existante ne matche
TR_AUTOCREATE_TRANSFER=false
