# Variables d'environnement — Trade Republic → Actual Budget Sync
# Copiez ce fichier en .env et remplissez les valeurs

# ── Général ────────────────────────────────────────────────────────────────
# "production" pour utiliser les vraies API, "mock" pour les tests
APP_MODE=production

# ── Trade Republic ──────────────────────────────────────────────────────────
# Numéro de téléphone au format international (ex : +33600000000)
TR_PHONE_NUMBER=+33600000000
# Code PIN Trade Republic (4 chiffres)
TR_PIN=1234
# Chemin vers le fichier de cookies (permet de ne pas se reconnecter à chaque démarrage)
TR_COOKIES_FILE=./pytr_cookies.json

# ── Actual Budget ───────────────────────────────────────────────────────────
# URL de votre instance Actual Budget (sans slash final)
ACTUAL_URL=http://localhost:5006
# Mot de passe de votre instance Actual Budget
ACTUAL_PASSWORD=
# Nom ou file_id du budget cible (obtenez-le via GET /actual/files)
ACTUAL_BUDGET_ID=Mon Budget
# Nom exact du compte dans lequel importer les transactions
ACTUAL_ACCOUNT_NAME=Trade Republic

