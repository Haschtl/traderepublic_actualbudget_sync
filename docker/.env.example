# Variables d'environnement — Trade Republic → Actual Budget Sync
# Copiez ce fichier en .env et remplissez les valeurs

# ── Général ────────────────────────────────────────────────────────────────
# "production" pour utiliser les vraies API, "mock" pour les tests
APP_MODE=production
# Cron 5 champs pour le sync automatique. Vide = désactivé. Défaut: tous les jours à 00:00.
SYNC_CRON=0 1 * * *
# Optional: protège l'UI et l'API par Basic Auth si les deux valeurs sont remplies
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=

# ── Trade Republic ──────────────────────────────────────────────────────────
# Numéro de téléphone au format international (ex : +33600000000)
TR_PHONE_NUMBER=+33600000000
# Code PIN Trade Republic (4 chiffres)
TR_PIN=1234
# Chemin vers le fichier de cookies (permet de ne pas se reconnecter à chaque démarrage)
TR_COOKIES_FILE=./pytr_cookies.json

# ── Actual Budget ───────────────────────────────────────────────────────────
# URL de votre instance Actual Budget (sans slash final)
ACTUAL_URL=http://localhost:5006
# Mot de passe de votre instance Actual Budget
ACTUAL_PASSWORD=
# Mot de passe de chiffrement du fichier budget Actual (laissez vide si non chiffré)
ACTUAL_ENCRYPTION_PASSWORD=
# Nom ou file_id du budget cible (obtenez-le via GET /actual/files)
ACTUAL_BUDGET_ID=Mon Budget
# Comptes Actual auto-créés pour Trade Republic
ACTUAL_CASH_ACCOUNT_NAME=Trade Republic Cash
ACTUAL_DEPOT_ACCOUNT_NAME=Trade Republic Depot
# Optional: compte externe pour BANK_TRANSACTION_INCOMING/OUTGOING
ACTUAL_TRANSFER_ACCOUNT_NAME=
# Optional: si true, crée une contre-écriture externe si aucune transaction existante ne matche
TR_AUTOCREATE_TRANSFER=false
